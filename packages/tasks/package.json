{
  "name": "@workspace/tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf .turbo node_modules",
    "worker": "pnpm with-env tsx src/scripts/wakaqWorker.ts",
    "scheduler": "pnpm with-env tsx src/scripts/wakaqScheduler.ts",
    "info": "pnpm with-env tsx src/scripts/wakaqInfo.ts",
    "purge": "pnpm with-env tsx src/scripts/wakaqPurge.ts",
    "with-env": "dotenv -e ../../.env -c --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vscode/vscode-languagedetection": "^1.0.23",
    "@workspace/core": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/external": "workspace:*",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.6",
    "node-html-parser": "^9.0.4",
    "slugify": "^1.6.9",
    "ts-duration": "^1.1.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "wakaq": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "@types/web-app-manifest": "^1.0.9",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1"
  }
}
